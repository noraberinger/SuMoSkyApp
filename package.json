{
  "name": "sumoskyapp",
  "version": "1.0.0",
  "description": "3D viewer tool supporting interactive analysis and visualization of sun, moon, sky and landscape constellations.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.ifi.uzh.ch/vmml/sumoskyapp"
  },
  "author": "Nora Beringer",
  "license": "MIT",
  "workspaces": [
    "packages/server",
    "packages/client",
    "webgisterrain/terrender-core"
  ],
  "devDependencies": {
    "@eslint/compat": "^1.2.2",
    "@eslint/js": "^9.13.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "verbose": true,
    "moduleDirectories": [
      "node_modules",
      "packages"
    ],
    "roots": [
      "<rootDir>/packages"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testMatch": [
      "**/?(*.)+(spec|test).ts?(x)"
    ]
  }
}
